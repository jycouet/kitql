{
	"compilerOptions": {
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"module": "esnext",
		"target": "es2022",
		"lib": ["esnext", "dom"],
		"moduleResolution": "bundler",
		"noImplicitThis": true,
		"strict": true,
		"alwaysStrict": true,
		"noImplicitReturns": true,
		"noUnusedLocals": false,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"checkJs": true
	},
	"include": ["packages"],
	"exclude": ["**/dist", "**/temp"]
}
