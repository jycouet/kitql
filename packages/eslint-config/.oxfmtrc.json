{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"tabWidth": 1,
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "all",
	"semi": false,
	"arrowParens": "always",
	"printWidth": 100,
	"sortPackageJson": false,
	"svelte": true,
	"sortTailwindcss": true,
	"sortImports": {
		"groups": [
			"builtin",
			{ "newlinesBetween": false },
			"external",
			"remult",
			{ "newlinesBetween": false },
			"firstly",
			{ "newlinesBetween": false },
			"kitql",
			"env",
			{ "newlinesBetween": false },
			"app",
			"firstly-aliases",
			{ "newlinesBetween": false },
			"aliases",
			["parent", "sibling", "index"],
			"unknown"
		],
		"customGroups": [
			{ "groupName": "remult", "elementNamePattern": ["remult", "remult/**"] },
			{ "groupName": "firstly", "elementNamePattern": ["firstly", "firstly/**"] },
			{ "groupName": "kitql", "elementNamePattern": ["@kitql/**"] },
			{ "groupName": "env", "elementNamePattern": ["$env", "$env/**"] },
			{ "groupName": "app", "elementNamePattern": ["$app", "$app/**"] },
			{
				"groupName": "firstly-aliases",
				"elementNamePattern": ["$server", "$server/**", "$modules", "$modules/**"]
			},
			{ "groupName": "aliases", "elementNamePattern": ["$*", "$*/**", "#*", "#*/**"] }
		],
		"newlinesBetween": true
	},
	"ignorePatterns": []
}
